# Contentful (required for content). Space ID: rfvqnggtcs8w
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_DELIVERY_TOKEN=

# Google (optional until you want ratings and the map)
# Server-side key for the Places API (New): ratings, review counts, open now. Do not expose this one.
GOOGLE_MAPS_API_KEY=
# Browser key for the Maps JavaScript API. Restrict it to your site URL in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=

# Ask SW18 chatbot (optional until you want it live)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# Long random string. Lets the Sunday job refresh the cached Google data.
REVALIDATE_SECRET=

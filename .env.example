# Contentful (required for content). Space ID: rfvqnggtcs8w
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_DELIVERY_TOKEN=


# Ask SW18 chatbot (optional until you want it live)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# Best-effort limits (defaults shown). The hard cap is the monthly spend limit in the Anthropic Console.
# ASK_PER_10_MIN=10
# ASK_PER_IP_PER_DAY=40
# ASK_DAILY_LIMIT=400

# Long random string. Lets the Sunday job refresh cached events and news.
REVALIDATE_SECRET=

# Extra public calendar feeds for What's on (optional). Putney.news is built in.
# Format: Name|https://url/feed.ics, comma-separated. Use only feeds that are SW18-only or that you have permission to list.
EVENT_ICAL_FEEDS=
